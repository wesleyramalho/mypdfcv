# next-auth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# LinkedIn OAuth App credentials
# Register at: https://www.linkedin.com/developers/apps
# Required scopes: openid, profile, email
# For local dev callback, configure:
# http://localhost:3000/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Set true only when LinkedIn OAuth credentials are configured.
NEXT_PUBLIC_LINKEDIN_OAUTH_ENABLED=false

# YouTube subscribe prompt after PDF export
NEXT_PUBLIC_YOUTUBE_PROMPT_ENABLED=false

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error monitoring
# Both DSNs are optional — leaving them blank disables Sentry entirely.
# - NEXT_PUBLIC_SENTRY_DSN  → browser SDK. Init is gated on the existing
#   consent flag, so BR users must accept the LGPD banner first.
# - SENTRY_DSN              → Node/Edge runtimes. Always on when set;
#   request bodies and PII are scrubbed in src/lib/sentry/scrub.ts.
# - SENTRY_ENVIRONMENT      → optional override (defaults to NODE_ENV).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Geolocation
# Vercel injects `x-vercel-ip-country` on every request in production.
# Set DEV_COUNTRY to simulate a country in local dev (e.g. DEV_COUNTRY=BR to
# trigger the LGPD consent banner).
DEV_COUNTRY=
